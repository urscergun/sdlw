@PACKAGE_INIT@

# sdlw links SDL3 (installed alongside this package). Resolve it first so the
# imported sdlw::sdlw target's transitive SDL3 dependency is satisfied.
include(CMakeFindDependencyMacro)
find_dependency(SDL3)

include("${CMAKE_CURRENT_LIST_DIR}/sdlwTargets.cmake")

# Optional helper: sdlw_embed_asset() for baking fonts/assets into your exe.
include("${CMAKE_CURRENT_LIST_DIR}/sdlwEmbed.cmake" OPTIONAL)

check_required_components(sdlw)
